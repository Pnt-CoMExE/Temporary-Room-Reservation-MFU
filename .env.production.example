# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_DB=mfu_reservation
POSTGRES_USER=mfu_admin
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_production

# ==========================================
# Security & Secret Keys
# ==========================================
JWT_SECRET=change_this_jwt_secret_key_in_production
SESSION_SECRET=change_this_session_secret_key_in_production

# ==========================================
# Google OAuth 2.0 Credentials
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://space-booking.mfu.ac.th/api/auth/google/callback

# ==========================================
# PromptPay & Payment Configurations
# ==========================================
PROMPTPAY_ID=0575532000100
PAYMENT_MODE=promptpay_slip # Options: promptpay_slip | opn | scb | krungthai

# ==========================================
# SMTP Email & LINE Notifications
# ==========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=no-reply@mfu.ac.th
LINE_NOTIFY_TOKEN=your_line_notify_access_token
