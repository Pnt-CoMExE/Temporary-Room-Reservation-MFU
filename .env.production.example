# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_DB=mfu_reservation
POSTGRES_USER=mfu_admin
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_production

# ==========================================
# Security & Secret Keys
# ==========================================
JWT_SECRET=change_this_jwt_secret_key_in_production
SESSION_SECRET=change_this_session_secret_key_in_production

# ==========================================
# Google OAuth 2.0 Credentials
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback
FRONTEND_URL=http://localhost

# Local Docker HTTP testing — set false when not using HTTPS
# COOKIE_SECURE=false

# Local Docker UAT — disable API rate limits (do NOT set in real production)
# RATE_LIMIT_DISABLED=true

# UAT: ใส่อีเมล Google สำหรับทดสอบ Admin (คั่นด้วย comma)
# DEV_ADMIN_EMAILS=your@gmail.com

# ==========================================
# Payment Gateway Configurations (Modular Adapter)
# ==========================================
# Active Provider Options: promptpay_manual | opn | scb | kbank | ktb | mock_sandbox
PAYMENT_PROVIDER=mock_sandbox
PROMPTPAY_ID=0575532000100

# Opn Payments (Omise)
OPN_PUBLIC_KEY=pkey_test_xxxxxx
OPN_SECRET_KEY=skey_test_xxxxxx

# SCB Mae Manee / Open API
SCB_API_KEY=your_scb_api_key
SCB_API_SECRET=your_scb_api_secret
SCB_MERCHANT_ID=your_scb_merchant_id

# KBank K-Payment Gateway
KBANK_MERCHANT_ID=your_kbank_merchant_id
KBANK_SECRET_KEY=your_kbank_secret_key

# Krungthai Bank (KTB)
KTB_MERCHANT_ID=your_ktb_merchant_id
KTB_SECRET_KEY=your_ktb_secret_key


# ==========================================
# SMTP Email & LINE Notifications
# ==========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=no-reply@mfu.ac.th
LINE_NOTIFY_TOKEN=your_line_notify_access_token
