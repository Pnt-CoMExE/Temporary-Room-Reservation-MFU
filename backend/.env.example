# ==========================================
# MFU Space Reservation — Development .env
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# ==========================================

PORT=3000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_for_dev
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=room_booking_db
DB_USER=postgres
DB_PASSWORD=your_password

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ==========================================
# Payment — ใช้ mock_sandbox สำหรับ UAT (ไม่โอนเงินจริง)
# เปลี่ยนเป็น promptpay_manual เมื่อพร้อมทดสอบ QR จริง
# ==========================================
PAYMENT_PROVIDER=mock_sandbox
PROMPTPAY_ID=0575532000100

# ==========================================
# UAT Role Override (เมื่อไม่มีอีเมลหน่วยงาน)
# ใส่อีเมล Google ของคุณเพื่อทดสอบหน้า Admin ชั่วคราว
# คั่นด้วย comma ถ้ามีหลายอีเมล
# ==========================================
# DEV_ADMIN_EMAILS=your.personal@gmail.com

# Redis (optional — ใช้ memory store ถ้าไม่ตั้ง)
# REDIS_URL=redis://localhost:6379
