# ==========================================
# MFU Space Reservation — Development .env
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# ==========================================

PORT=3000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_for_dev
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=room_booking_db
DB_USER=postgres
DB_PASSWORD=your_password

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ==========================================
# Payment
# UAT เร็ว: mock_sandbox
# Stripe test จริง: ตั้งสองบรรทัดด้านล่าง + ใส่ sk_test_ จาก Dashboard
# ==========================================
PAYMENT_PROVIDER=mock_sandbox
PROMPTPAY_ID=0575532000100
# --- Stripe Test ---
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# APP_URL=http://localhost:3000

# ==========================================
# Demo/UAT Role Override (เมื่อไม่มีอีเมลหน่วยงาน)
# ใช้เฉพาะทดสอบ/Demo — ปิดใน production จริง
# คั่นด้วย comma ถ้ามีหลายอีเมล
# ==========================================
# DEV_ADMIN_EMAILS=your.personal@gmail.com
# DEV_INTERNAL_EMAILS=student@lamduan.mfu.ac.th

# SMTP (optional — ใช้ console log ถ้าไม่ตั้ง; รอเมลเซิร์ฟเวอร์จาก มฟล.)
# SMTP_HOST=smtp.mfu.ac.th
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=no-reply@mfu.ac.th

# Redis (optional — ใช้ memory store ถ้าไม่ตั้ง)
# REDIS_URL=redis://localhost:6379
